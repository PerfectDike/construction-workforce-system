generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RoleName {
  ADMIN
  PROJECT_MANAGER
  SITE_OFFICER
  VIEWER
}
enum ProjectStatus {
  ACTIVE
  ARCHIVED
}
enum TaskStatus {
  WORKING
  INACTIVE
}
enum AllocationStatus {
  APPROVED
  CANCELLED
  SUPERSEDED
}
enum SiteUpdateStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PUBLISHED
  WITHDRAWN
  SUPERSEDED
}

model Project {
  sharedId String? @unique
  id Int @id @default(autoincrement())
  name String
  description String?
  status ProjectStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tasks Task[]
  baselines Baseline[]
  memberships ProjectMembership[]
}

model Task {
  sharedId String? @unique
  id Int @id @default(autoincrement())
  projectId Int
  taskCode String
  title String
  description String?
  startDate DateTime @db.Date
  finishDate DateTime @db.Date
  isMilestone Boolean @default(false)
  status TaskStatus @default(WORKING)
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  predecessors TaskDependency[] @relation("SuccessorDependencies")
  successors TaskDependency[] @relation("PredecessorDependencies")
  skills TaskSkill[]
  allocations Allocation[]
  updates SiteUpdate[]
  baselineTasks BaselineTask[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([projectId, taskCode])
  @@index([projectId])
}

model TaskDependency {
  predecessorId Int
  successorId Int
  predecessor Task @relation("PredecessorDependencies", fields: [predecessorId], references: [id], onDelete: Restrict)
  successor Task @relation("SuccessorDependencies", fields: [successorId], references: [id], onDelete: Restrict)
  @@id([predecessorId, successorId])
}

model Baseline {
  id Int @id @default(autoincrement())
  projectId Int
  versionNo Int
  previousBaselineId Int?
  approvedById Int
  approvedAt DateTime @default(now())
  reason String?
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  previousBaseline Baseline? @relation("BaselineRevision", fields: [previousBaselineId], references: [id], onDelete: Restrict)
  revisions Baseline[] @relation("BaselineRevision")
  approvedBy User @relation("BaselineApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  tasks BaselineTask[]
  dependencies BaselineDependency[]
  @@unique([projectId, versionNo])
}

model BaselineTask {
  baselineId Int
  taskId Int
  taskCode String
  title String
  startDate DateTime @db.Date
  finishDate DateTime @db.Date
  isMilestone Boolean @default(false)
  baseline Baseline @relation(fields: [baselineId], references: [id], onDelete: Restrict)
  task Task @relation(fields: [taskId], references: [id], onDelete: Restrict)
  @@id([baselineId, taskId])
}

model BaselineDependency {
  baselineId Int
  predecessorId Int
  successorId Int
  baseline Baseline @relation(fields: [baselineId], references: [id], onDelete: Restrict)
  @@id([baselineId, predecessorId, successorId])
}

model Skill {
  id Int @id @default(autoincrement())
  name String @unique
  tasks TaskSkill[]
  workers WorkerSkill[]
}
model TaskSkill {
  taskId Int
  skillId Int
  task Task @relation(fields: [taskId], references: [id], onDelete: Restrict)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Restrict)
  @@id([taskId, skillId])
}
model Worker {
  sharedId String? @unique
  id Int @id @default(autoincrement())
  label String @unique
  dailyCapacityHours Decimal @db.Decimal(5,2)
  skills WorkerSkill[]
  availability WorkerAvailability[]
  allocations Allocation[]
}
model WorkerSkill {
  workerId Int
  skillId Int
  worker Worker @relation(fields: [workerId], references: [id], onDelete: Restrict)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Restrict)
  @@id([workerId, skillId])
}
model WorkerAvailability {
  id Int @id @default(autoincrement())
  workerId Int
  workDate DateTime @db.Date
  availableHours Decimal @db.Decimal(5,2)
  worker Worker @relation(fields: [workerId], references: [id], onDelete: Restrict)
  @@unique([workerId, workDate])
}
model Allocation {
  id Int @id @default(autoincrement())
  workerId Int
  taskId Int
  workDate DateTime @db.Date
  allocatedHours Decimal @db.Decimal(5,2)
  status AllocationStatus @default(APPROVED)
  replacesId Int? @unique
  reason String?
  createdAt DateTime @default(now())
  worker Worker @relation(fields: [workerId], references: [id], onDelete: Restrict)
  task Task @relation(fields: [taskId], references: [id], onDelete: Restrict)
  replaces Allocation? @relation("AllocationRevision", fields: [replacesId], references: [id], onDelete: Restrict)
  replacement Allocation? @relation("AllocationRevision")
  updates SiteUpdate[]
  @@index([workerId, workDate])
}

model Role {
  id Int @id @default(autoincrement())
  name RoleName @unique
  users User[]
}
model User {
  sharedId String? @unique
  id Int @id @default(autoincrement())
  loginLabel String @unique
  passwordHash String
  roleId Int
  accountStatus String @default("ACTIVE")
  recoveryContact String?
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)
  memberships ProjectMembership[]
  approvedBaselines Baseline[] @relation("BaselineApprover")
  authoredUpdates SiteUpdate[] @relation("UpdateAuthor")
  approvedUpdates SiteUpdate[] @relation("UpdateApprover")
  recoveryCodes RecoveryCode[]
  events ProvenanceEvent[]
}
model ProjectMembership {
  roleName RoleName?
  userId Int
  projectId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@id([userId, projectId])
}
model SiteUpdate {
  entryKey String?
  id Int @id @default(autoincrement())
  taskId Int
  allocationId Int?
  authorId Int
  approvedById Int?
  supersedesId Int? @unique
  workDate DateTime @db.Date
  progressPercent Int?
  recordedHours Decimal? @db.Decimal(5,2)
  actualFinishDate DateTime? @db.Date
  note String?
  status SiteUpdateStatus @default(DRAFT)
  isCurrent Boolean @default(false)
  decisionReason String?
  createdAt DateTime @default(now())
  task Task @relation(fields: [taskId], references: [id], onDelete: Restrict)
  allocation Allocation? @relation(fields: [allocationId], references: [id], onDelete: Restrict)
  author User @relation("UpdateAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  approvedBy User? @relation("UpdateApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  supersedes SiteUpdate? @relation("UpdateRevision", fields: [supersedesId], references: [id], onDelete: Restrict)
  replacement SiteUpdate? @relation("UpdateRevision")
  @@index([taskId, status])
}
model RecoveryCode {
  id Int @id @default(autoincrement())
  userId Int
  codeHash String
  issuedAt DateTime @default(now())
  expiresAt DateTime
  usedAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model ProvenanceEvent {
  id Int @id @default(autoincrement())
  entityType String
  entityId Int
  action String
  fromState String?
  toState String?
  actorId Int
  reason String?
  occurredAt DateTime @default(now())
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@index([entityType, entityId])
}

